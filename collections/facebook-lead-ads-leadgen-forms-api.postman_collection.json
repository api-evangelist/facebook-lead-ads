  "info": {
    "_postman_id": "81d0dd46-fe89-44b7-88bf-381f6d8daba8",
    "name": "Meta Marketing API - Lead Ads Bulk Leads Leadgen Forms API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Graph API endpoints for managing Facebook and Instagram lead\ngeneration forms, retrieving captured leads, downloading bulk lead\nexports, and configuring leadgen webhooks. Authentication uses a\nPage access token (OAuth 2.0 bearer) with the leads_retrieval,\npages_show_list, and pages_manage_ads permissions granted by a Page\nadmin.\n\n\nContact Support:\n Name: Meta for Developers",
      "type": "text/plain"
    }
